@model List<CoffeeShop.Models.BlogPost>

<section class="home-slider owl-carousel">
  <div class="slider-item" style="background-image: url(/images/bg_3.jpg);" data-stellar-background-ratio="0.5">
    <div class="overlay"></div>
    <div class="container">
      <div class="row slider-text justify-content-center align-items-center">
        <div class="col-md-7 col-sm-12 text-center ftco-animate">
            <h1 class="mb-3 mt-5 bread">Blog</h1>
            <p class="breadcrumbs"><span class="mr-2"><a href="/Home/Index">Home</a></span> <span>Blog</span></p>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="ftco-section">
  <div class="container">
    <div class="row d-flex">
      @if(Model != null)
      {
          foreach(var blog in Model)
          {
              <div class="col-md-4 d-flex ftco-animate">
                  <div class="blog-entry align-self-stretch">
                  <a href="/Home/BlogSingle/@blog.Id" class="block-20" style="background-image: url('@blog.ImageUrl');"></a>
                  <div class="text py-4 d-block">
                      <div class="meta">
                      <div><a href="#">@blog.CreatedAt.ToString("MMM dd, yyyy")</a></div>
                      <div><a href="#">@blog.Author</a></div>
                      <div><a href="#" class="meta-chat"><span class="icon-chat"></span> @blog.CommentCount</a></div>
                      </div>
                      <h3 class="heading mt-2"><a href="/Home/BlogSingle/@blog.Id">@blog.Title</a></h3>
                      <p>@blog.Content.Substring(0, Math.Min(blog.Content.Length, 100))...</p>
                  </div>
                  </div>
              </div>
          }
      }
    </div>
  </div>
</section>