@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Şifrəni Sıfırla</title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />

    <style>
        body {
            height: 100vh;
            background: linear-gradient(135deg,#0f2027,#203a43,#2c5364);
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'Segoe UI';
        }

        .reset-card {
            width: 450px;
            padding: 40px;
            border-radius: 12px;
            background: white;
            box-shadow: 0 10px 35px rgba(0,0,0,0.25);
        }

        .reset-title {
            text-align: center;
            font-weight: 600;
            margin-bottom: 25px;
        }

        .logo {
            text-align: center;
            font-size: 28px;
            font-weight: 700;
            margin-bottom: 10px;
            color: #2c5364;
        }

        .form-control {
            height: 45px;
        }

        .btn-reset {
            height: 45px;
            font-weight: 600;
        }

        .links {
            text-align: center;
            margin-top: 15px;
        }
    </style>
</head>

<body>

    <div class="reset-card">

        <div class="logo">
            ☕ CoffeeShop
        </div>

        <h4 class="reset-title">Şifrəni Sıfırla</h4>

        <form method="post">
            @Html.AntiForgeryToken()

            <div class="mb-3">
                <label class="form-label">Username</label>
                <input name="username" class="form-control" required />
            </div>

            <div class="mb-3">
                <label class="form-label">Admin emailindən gələn kod</label>
                <input name="code" class="form-control" required />
            </div>

            <div class="mb-3">
                <label class="form-label">Yeni şifrə</label>
                <input name="newPassword" type="password" class="form-control" required />
            </div>

            <button class="btn btn-success w-100 btn-reset">Yadda saxla</button>

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger mt-3 text-center">
                    @ViewBag.Error
                </div>
            }

            <div class="links">
                <a href="/Admin/Login">Login səhifəsinə qayıt</a>
            </div>

        </form>

    </div>

</body>
</html>