@model List<CoffeeShop.Models.Product>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Məhsullar";
}

<div class="d-flex flex-wrap align-items-end justify-content-between gap-2 mb-3">
    <div>
        <h2 class="mb-1" style="font-weight:800;">Məhsullar</h2>
        <div class="muted">Məhsul siyahısı, axtarış və əməliyyatlar</div>
    </div>

    <div class="d-flex flex-wrap gap-2">
        <div class="glass px-2 py-2" style="border-radius:14px;">
            <input id="productSearch"
                   class="form-control"
                   placeholder="Axtar"
                   style="min-width:260px;
                          background:rgba(255,255,255,.06);
                          border:1px solid rgba(255,255,255,.12);
                          color:rgba(255,255,255,.92)" />
        </div>

        <a href="/Admin/CreateProduct" class="btn-ghost text-decoration-none">
            + Yeni Məhsul
        </a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

@if (Model == null || !Model.Any())
{
    <div class="glass p-4 text-center">
        <div style="font-size:42px;">🧁</div>
        <h4 class="mt-2" style="font-weight:800;">Hələ məhsul yoxdur</h4>
        <div class="muted">İlk məhsulu əlavə etmək üçün düyməyə kliklə.</div>

        <div class="mt-3">
            <a href="/Admin/CreateProduct" class="btn-ghost text-decoration-none">+ Yeni Məhsul Əlavə Et</a>
        </div>
    </div>
}
else
{
    <div class="glass tilt p-2" style="background: rgba(0,0,0,.22);">
        <div class="table-responsive">
            <table class="table align-middle mb-0" id="productsTable"
                   style="--bs-table-bg: transparent; --bs-table-color: rgba(255,255,255,.92);">

                <thead>
                    <tr style="color:rgba(255,255,255,.88); border-bottom:1px solid rgba(255,255,255,.14);">
                        <th style="width:72px;">Şəkil</th>
                        <th>Ad</th>
                        <th style="width:140px;">Qiymət</th>
                        <th style="width:180px;">Kateqoriya</th>
                        <th style="width:210px;">Əməliyyat</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr class="rowItem" style="border-top:1px solid rgba(255,255,255,.10);">
                            <td>
                                <div style="width:54px;height:54px;border-radius:14px;overflow:hidden;
                                                border:1px solid rgba(255,255,255,.12);
                                                background:rgba(255,255,255,.06);
                                                display:flex;align-items:center;justify-content:center;">
                                    @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                                    {
                                        <img src="@item.ImageUrl" style="width:100%;height:100%;object-fit:cover;" />
                                    }
                                    else
                                    {
                                        <span class="muted">—</span>
                                    }
                                </div>
                            </td>

                            <td>
                                <div style="font-weight:800;">@item.Name</div>
                                
                            </td>

                            <td>
                                <span class="badge"
                                      style="background:rgba(110,231,255,.16);
                                                 border:1px solid rgba(110,231,255,.40);
                                                 color:rgba(255,255,255,.96);
                                                 padding:8px 12px;
                                                 border-radius:999px;
                                                 font-weight:800;">
                                    $@item.Price
                                </span>
                            </td>

                            <td>
                                <span class="badge"
                                      style="background:rgba(167,139,250,.16);
                                                 border:1px solid rgba(167,139,250,.40);
                                                 color:rgba(255,255,255,.96);
                                                 padding:8px 12px;
                                                 border-radius:999px;
                                                 font-weight:800;">
                                    @(item.Category != null ? item.Category.Name : "-")
                                </span>
                            </td>

                            <td style="white-space:nowrap;">
                                <a asp-action="EditProduct"
                                   asp-controller="Admin"
                                   asp-route-id="@item.Id"
                                   class="btn-ghost text-decoration-none me-2">
                                    ✏️ Düzəliş
                                </a>

                                <form asp-action="DeleteProduct"
                                      asp-controller="Admin"
                                      method="post"
                                      class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <button type="submit"
                                            class="btn-ghost"
                                            style="border-color:rgba(255,99,132,.45);"
                                            onclick="return confirm('Silmək istədiyinizə əminsiniz?');">
                                        🗑️ Sil
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="muted mt-2">
        Göstərilən: <span id="shownCount">@Model.Count</span> / @Model.Count
    </div>
}

@section Scripts {
    <script>
        
        (function(){
            const input = document.getElementById("productSearch");
            const table = document.getElementById("productsTable");
            const shown = document.getElementById("shownCount");
            if(!input || !table) return;

            function norm(s){ return (s||"").toString().toLowerCase().trim(); }

            input.addEventListener("input", function(){
                const q = norm(input.value);
                const rows = table.querySelectorAll("tbody .rowItem");
                let visible = 0;

                rows.forEach(r => {
                    const text = norm(r.innerText);
                    const ok = q === "" || text.includes(q);
                    r.style.display = ok ? "" : "none";
                    if(ok) visible++;
                });

                if(shown) shown.textContent = visible;
            });
        })();
    </script>
}