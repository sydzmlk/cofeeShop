@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Admin Login</title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />

    <style>
        body {
            height: 100vh;
            background: linear-gradient(135deg,#0f2027,#203a43,#2c5364);
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'Segoe UI';
        }

        .login-card {
            width: 420px;
            padding: 40px;
            border-radius: 12px;
            background: white;
            box-shadow: 0 10px 35px rgba(0,0,0,0.25);
        }

        .login-title {
            text-align: center;
            font-weight: 600;
            margin-bottom: 25px;
        }

        .form-control {
            height: 45px;
        }

        .btn-login {
            height: 45px;
            font-weight: 600;
        }

        .login-links {
            text-align: center;
            margin-top: 15px;
        }

            .login-links a {
                text-decoration: none;
                font-size: 14px;
            }

                .login-links a:hover {
                    text-decoration: underline;
                }

        .logo {
            text-align: center;
            font-size: 28px;
            font-weight: 700;
            margin-bottom: 10px;
            color: #2c5364;
        }
    </style>
</head>

<body>

    <div class="login-card">

        <div class="logo">
            ☕ CoffeeShop
        </div>

        <h4 class="login-title">Admin Panel Login</h4>

        <form method="post">
            @Html.AntiForgeryToken()

            <div class="mb-3">
                <input name="username" class="form-control" placeholder="Username" required />
            </div>

            <div class="mb-3">
                <input name="password" type="password" class="form-control" placeholder="Password" required />
            </div>

            <button class="btn btn-dark w-100 btn-login">Login</button>

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger mt-3 text-center">
                    @ViewBag.Error
                </div>
            }

            <div class="login-links">
                <a href="/Admin/ForgotPassword">Şifrəni unutdum</a>
                <br />
                <a href="/Admin/ResetPassword">Kodla sıfırla</a>
            </div>

        </form>

    </div>

</body>
</html>