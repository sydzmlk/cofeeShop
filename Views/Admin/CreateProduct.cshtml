@model CoffeeShop.Models.Product
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Yeni Məhsul";
}

<div class="d-flex flex-wrap align-items-end justify-content-between gap-2 mb-3">
    <div>
        <h2 class="mb-1" style="font-weight:800;">Yeni Məhsul Əlavə Et</h2>
        <div class="muted">Məhsul məlumatlarını daxil et və yadda saxla</div>
    </div>

    <a href="/Admin/Products" class="btn-ghost text-decoration-none">← Məhsullara qayıt</a>
</div>

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger">
        Xahiş olunur formu düzgün doldurun.
    </div>
}

<div class="row g-3">
    <div class="col-lg-7">
        <div class="glass tilt p-3" style="background: rgba(0,0,0,.22);">
            <form asp-action="CreateProduct" asp-controller="Admin" method="post">
                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label class="form-label">Məhsulun adı</label>
                    <input asp-for="Name" class="form-control"
                           placeholder="Məs: Espresso"
                           style="background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.12);color:rgba(255,255,255,.92);"
                           required />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label">Açıqlama</label>
                    <textarea asp-for="Description" class="form-control" rows="4"
                              placeholder="Qısa təsvir..."
                              style="background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.12);color:rgba(255,255,255,.92);"
                              required></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Qiymət ($)</label>
                        <input asp-for="Price" type="number" step="0.01" class="form-control"
                               placeholder="Məs: 4.50"
                               style="background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.12);color:rgba(255,255,255,.92);"
                               required />
                        <span asp-validation-for="Price" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Kateqoriya</label>


                        <select asp-for="CategoryId" class="form-select"
                                style="background:rgba(255,255,255,.06);
               border:1px solid rgba(255,255,255,.12);
               color: rgba(255,255,255,.92);"
                                required>

                            <option value="" style="color:black;">Seçin...</option>

                            @if (ViewBag.Categories != null)
                            {
                                foreach (var c in ViewBag.Categories)
                                {
                                    <option value="@c.Id" style="color:black;">@c.Name</option>
                                }
                            }
                        </select>

                        <span asp-validation-for="CategoryId" class="text-danger"></span>
                        <div class="muted mt-1" style="font-size:12px;"></div>
                    </div>
                </div>

                <div class="mt-3">
                    <label class="form-label">Şəkil URL</label>
                    <input asp-for="ImageUrl" id="imgUrl" class="form-control"
                           placeholder="https://..."
                           style="background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.12);color:rgba(255,255,255,.92);"
                           required />
                    <span asp-validation-for="ImageUrl" class="text-danger"></span>
                    <div class="muted mt-1" style="font-size:12px;">Link yazdıqca sağda preview yenilənəcək.</div>
                </div>

                <div class="d-flex flex-wrap gap-2 mt-4">
                    <button type="submit" class="btn-ghost" style="font-weight:800;">
                        ✅ Yadda Saxla
                    </button>
                    <a href="/Admin/Products" class="btn-ghost text-decoration-none" style="border-color:rgba(255,255,255,.18);">
                        ↩ Geri Qayıt
                    </a>
                </div>
            </form>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="glass tilt p-3" style="background: rgba(0,0,0,.22);">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <div style="font-weight:800;">Şəkil Preview</div>
                    <div class="muted">URL daxil etdikcə görüntü çıxacaq</div>
                </div>
                <div class="muted">🖼️</div>
            </div>

            <div class="mt-3"
                 style="border-radius:18px; overflow:hidden; border:1px solid rgba(255,255,255,.12); background:rgba(255,255,255,.06);">
                <img id="imgPreview"
                     src=""
                     alt="Preview"
                     style="width:100%;height:320px;object-fit:cover;display:none;" />
                <div id="imgEmpty"
                     class="muted text-center"
                     style="padding:70px 18px;">
                    Şəkil linki yaz, burada görünsün
                </div>
            </div>

            <div class="muted mt-2" style="font-size:12px;">
              
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function(){
            const input = document.getElementById("imgUrl");
            const img = document.getElementById("imgPreview");
            const empty = document.getElementById("imgEmpty");

            if(!input || !img || !empty) return;

            function setPreview(url){
                const u = (url || "").trim();
                if(!u){
                    img.style.display = "none";
                    empty.style.display = "block";
                    img.src = "";
                    return;
                }
                img.src = u;
                img.onload = () => {
                    empty.style.display = "none";
                    img.style.display = "block";
                };
                img.onerror = () => {
                    img.style.display = "none";
                    empty.style.display = "block";
                    empty.textContent = "Şəkil açılmadı. URL səhv ola bilər.";
                };
            }

            setPreview(input.value);

            input.addEventListener("input", function(){
                setPreview(input.value);
            });
        })();
    </script>
}