@model CoffeeShop.Models.BlogPost

@{
    Layout = "_AdminLayout";
}

<h2>Create Blog Post</h2>

<form method="post" enctype="multipart/form-data" class="mt-3">
    @Html.AntiForgeryToken()

    <div class="mb-3">
        <label class="form-label">Title</label>
        <input class="form-control" asp-for="Title" />
        <span class="text-danger" asp-validation-for="Title"></span>
    </div>

    <div class="mb-3">
        <label class="form-label">Author</label>
        <input class="form-control" asp-for="Author" />
    </div>

    <div class="mb-3">
        <label class="form-label">Content</label>
        <textarea class="form-control" asp-for="Content" rows="8"></textarea>
        <span class="text-danger" asp-validation-for="Content"></span>
        <div class="form-text">Tip: keep it 200–600 words for a nice demo.</div>
    </div>

    <div class="mb-3">
        <label class="form-label">Image (optional)</label>
        <input type="file" name="imageFile" class="form-control" accept="image/*" />
        <div class="form-text">If you don't upload, a default image will be used.</div>
    </div>

    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-success">Save</button>
        <a class="btn btn-secondary" href="/Admin/BlogPosts">Cancel</a>
    </div>
</form>
