@model CoffeeShop.Models.ContactMessage
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Cavab yaz";
}

<div class="d-flex flex-wrap align-items-end justify-content-between gap-2 mb-3">
    <div>
        <h2 class="mb-1" style="font-weight:800;">Cavab yaz</h2>
        <div class="muted">Mesaj detalları, cavab və tarixçə</div>
    </div>

    <a class="btn-ghost text-decoration-none" asp-controller="Admin" asp-action="Messages">← Mesajlara qayıt</a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="row g-3">

 
    <div class="col-lg-5">
        <div class="glass tilt p-3" style="background: rgba(0,0,0,.22);">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <div style="font-weight:900;font-size:16px;">Gələn mesaj</div>
                    <div class="muted" style="font-size:12px;">ID: @Model.Id</div>
                </div>

                @if (Model.IsReplied)
                {
                    <span class="badge"
                          style="background:rgba(110,231,255,.16);
                                     border:1px solid rgba(110,231,255,.40);
                                     color:rgba(255,255,255,.96);
                                     padding:8px 12px;
                                     border-radius:999px;
                                     font-weight:800;">
                        Cavablanıb
                    </span>
                }
                else
                {
                    <span class="badge"
                          style="background:rgba(255,99,132,.16);
                                     border:1px solid rgba(255,99,132,.42);
                                     color:rgba(255,255,255,.96);
                                     padding:8px 12px;
                                     border-radius:999px;
                                     font-weight:800;">
                        Yeni
                    </span>
                }
            </div>

            <hr style="border-color:rgba(255,255,255,.12);" />

            <div class="mb-2"><b>Ad:</b> <span class="muted">@Model.Name</span></div>
            <div class="mb-2 d-flex align-items-center justify-content-between gap-2">
                <div><b>Email:</b> <span class="muted" id="senderEmail">@Model.Email</span></div>
                <button type="button" class="btn-ghost" onclick="copyText('senderEmail')" title="Emaili kopyala">📋</button>
            </div>
            <div class="mb-2"><b>Mövzu:</b> <span class="muted">@Model.Subject</span></div>
            <div class="mb-2"><b>Tarix:</b> <span class="muted">@Model.SentAt.ToString("dd.MM.yyyy HH:mm")</span></div>

            <div class="mt-3">
                <div class="d-flex align-items-center justify-content-between">
                    <b>Mesaj</b>
                    <button type="button" class="btn-ghost" onclick="copyRawMessage()" title="Mesajı kopyala">📋 Kopyala</button>
                </div>

                <div id="rawMessage"
                     style="margin-top:10px;
                            white-space:pre-wrap;
                            line-height:1.45;
                            padding:12px;
                            border-radius:14px;
                            background:rgba(255,255,255,.06);
                            border:1px solid rgba(255,255,255,.12);">
                    @Model.Message
                </div>
            </div>
        </div>
    </div>

    
    <div class="col-lg-7">
        <div class="glass tilt p-3" style="background: rgba(0,0,0,.22);">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <div style="font-weight:900;font-size:16px;">Cavab formu</div>
                    <div class="muted" style="font-size:12px;">Cavab göndərdikdən sonra tarixçədə saxlanacaq</div>
                </div>
                <div class="muted">✉️</div>
            </div>

            <hr style="border-color:rgba(255,255,255,.12);" />

            <form asp-controller="Admin" asp-action="ReplyMessage" asp-route-id="@Model.Id" method="post" id="replyForm">
                @Html.AntiForgeryToken()

                <div class="mb-2 d-flex flex-wrap gap-2">
                    <button type="button" class="btn-ghost" onclick="insertTemplate('salam')">Şablon: Salam</button>
                    <button type="button" class="btn-ghost" onclick="insertTemplate('tesekkur')">Şablon: Təşəkkür</button>
                    <button type="button" class="btn-ghost" onclick="insertTemplate('baglanis')">Şablon: Bağlanış</button>
                </div>

                <div class="mb-3">
                    <label class="form-label">Subject</label>
                    <input name="subject"
                           class="form-control"
                           value="Re: @Model.Subject"
                           placeholder="Subject"
                           style="background:rgba(255,255,255,.06);
                                  border:1px solid rgba(255,255,255,.12);
                                  color:rgba(255,255,255,.92);"
                           required />
                </div>

                <div class="mb-3">
                    <label class="form-label">Cavab mətni</label>
                    <textarea name="body"
                              id="replyBody"
                              class="form-control"
                              rows="8"
                              placeholder="Cavab mətni..."
                              style="background:rgba(255,255,255,.06);
                                     border:1px solid rgba(255,255,255,.12);
                                     color:rgba(255,255,255,.92);"
                              required></textarea>

                    <div class="muted mt-1" style="font-size:12px;">
                        İpucu: “Mesaj” hissəsindən copy edib cavaba əlavə edə bilərsən.
                    </div>
                </div>

                <div class="d-flex flex-wrap gap-2">
                    <button class="btn-ghost" type="submit" id="sendBtn" style="font-weight:900;">
                        ✅ Göndər
                    </button>
                    <button class="btn-ghost" type="button" onclick="clearBody()" style="border-color:rgba(255,255,255,.18);">
                        🧽 Təmizlə
                    </button>
                    <a class="btn-ghost text-decoration-none" asp-controller="Admin" asp-action="Messages" style="border-color:rgba(255,255,255,.18);">
                        ↩ Geri
                    </a>
                </div>
            </form>
        </div>

        @if (Model.Replies?.Any() == true)
        {
            <div class="glass p-3 mt-3" style="background: rgba(0,0,0,.22);">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div style="font-weight:900;font-size:16px;">Əvvəlki cavablar</div>
                        <div class="muted" style="font-size:12px;">Göndərilən reply-lərin tarixçəsi</div>
                    </div>
                    <div class="muted">🕘</div>
                </div>

                <hr style="border-color:rgba(255,255,255,.12);" />

                <div class="table-responsive">
                    <table class="table align-middle mb-0"
                           style="--bs-table-bg: transparent; --bs-table-color: rgba(255,255,255,.92);">
                        <thead>
                            <tr style="color:rgba(255,255,255,.88); border-bottom:1px solid rgba(255,255,255,.14);">
                                <th style="width:170px;">Tarix</th>
                                <th style="width:200px;">Subject</th>
                                <th>Mətn</th>
                                <th style="width:160px;">Kim göndərib</th>
                                <th style="width:140px;">Əməliyyat</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var r in Model.Replies.OrderByDescending(x => x.SentAt))
                            {
                                <tr style="border-top:1px solid rgba(255,255,255,.10);">
                                    <td>
                                        <div style="font-weight:800;">@r.SentAt.ToString("dd.MM.yyyy")</div>
                                        <div class="muted" style="font-size:12px;">@r.SentAt.ToString("HH:mm")</div>
                                    </td>
                                    <td>@r.Subject</td>
                                    <td>
                                        <div style="max-width:520px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">
                                            @r.Body
                                        </div>
                                    </td>
                                    <td>@r.SentBy</td>
                                    <td style="white-space:nowrap;">
                                        <form asp-controller="Admin"
                                              asp-action="DeleteReply"
                                              method="post"
                                              class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@r.Id" />
                                            <input type="hidden" name="messageId" value="@Model.Id" />

                                            <button type="submit"
                                                    class="btn-ghost"
                                                    style="border-color:rgba(255,99,132,.45);"
                                                    onclick="return confirm('Bu cavab silinsin?');">
                                                🗑️ Sil
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="muted mt-2" style="font-size:12px;">
                    Qeyd: Reply-ləri yalnız Admin silə bilər (səndə controller bunu artıq yoxlayır).
                </div>
            </div>
        }
    </div>

</div>

@section Scripts {
    <script>
        function copyText(id){
            const el = document.getElementById(id);
            if(!el) return;
            const text = (el.innerText || "").trim();
            if(!text) return;
            navigator.clipboard.writeText(text).then(() => toast("Kopyalandı ✅"));
        }

        function copyRawMessage(){
            const el = document.getElementById("rawMessage");
            if(!el) return;
            const text = (el.innerText || "").trim();
            if(!text) return;
            navigator.clipboard.writeText(text).then(() => toast("Mesaj kopyalandı ✅"));
        }

        function clearBody(){
            const t = document.getElementById("replyBody");
            if(t) t.value = "";
        }

        function insertTemplate(type){
            const t = document.getElementById("replyBody");
            if(!t) return;

            const templates = {
                salam: "Salam,\n\n",
                tesekkur: "\n\nMüraciətiniz üçün təşəkkür edirik.",
                baglanis: "\n\nHörmətlə,\nCoffeeShop Support"
            };

            t.value = (t.value || "") + (templates[type] || "");
            t.focus();
        }

      
        function toast(msg){
            const d = document.createElement("div");
            d.innerText = msg;
            d.style.position = "fixed";
            d.style.right = "18px";
            d.style.bottom = "18px";
            d.style.padding = "10px 12px";
            d.style.borderRadius = "12px";
            d.style.background = "rgba(0,0,0,.55)";
            d.style.border = "1px solid rgba(255,255,255,.18)";
            d.style.color = "rgba(255,255,255,.92)";
            d.style.backdropFilter = "blur(10px)";
            d.style.zIndex = 9999;
            document.body.appendChild(d);
            setTimeout(() => d.remove(), 1400);
        }

       
        (function(){
            const form = document.getElementById("replyForm");
            const btn = document.getElementById("sendBtn");
            if(!form || !btn) return;

            form.addEventListener("submit", function(){
                btn.disabled = true;
                btn.innerText = "Göndərilir...";
            });
        })();
    </script>
}