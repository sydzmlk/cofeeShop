@model CoffeeShop.Models.Product

<section class="ftco-section">
    <div class="container">
        <div class="row">

            <div class="col-md-6">
                <img class="img-fluid"
                     src="@(string.IsNullOrEmpty(Model.ImageUrl) ? Url.Content("~/images/dish-1.jpg") : Model.ImageUrl)" />
            </div>

            <div class="col-md-6">
                <h2>@Model.Name</h2>
                <p>@Model.Price ₼</p>

                <p>@Model.Description</p>

                <a asp-controller="Shop"
                   asp-action="Index"
                   class="btn btn-primary">
                    Back to Shop
                </a>
            </div>

        </div>
    </div>
</section>